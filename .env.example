# Path to the FFmpeg executable
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Local directories
INPUT_DIR=./data/input
OUTPUT_DIR=./data/output
AUTOSHORTS_AUTOMATION_CONFIG=./config/automation.local.json
AUTOSHORTS_STATE_DB=./data/autoshorts.db

# Processing configuration
MAX_WORKERS=1
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
MAX_CLIP_DURATION=60
EXTRA_CLIP_SECONDS=6

# Encoding
VIDEO_CODEC=libx264
VIDEO_PRESET=medium
VIDEO_CRF=20
AUDIO_CODEC=aac
AUDIO_BITRATE=192k

# Existing output behavior: error, skip, or replace
OVERWRITE_POLICY=error
