[Unit]
Description=Conservative AutoShorts runtime retention

[Service]
Type=oneshot
User=lpao
Group=lpao
WorkingDirectory=/srv/projects/autoshorts
EnvironmentFile=/srv/autoshorts/run/runtime.env
EnvironmentFile=/srv/autoshorts/run/secrets.env
ExecStart=/srv/projects/autoshorts/.venv/bin/python tools/autoshorts_retention.py --runtime /srv/autoshorts
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
